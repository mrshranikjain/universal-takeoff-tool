{
  "hvac": {
    "name": "HVAC",
    "title_keywords": ["HVAC", "AIR CONDITIONING", "VENTILATION", "AHU", "DUCT", "MECHANICAL"],
    "color_layers": {
      "magenta": "ductwork",
      "blue": "chilled_water",
      "green": "supply_air",
      "cyan": "condensate",
      "orange": "equipment"
    },
    "tag_patterns": {
      "AHU": {"regex": "AHU[- ]?ROOM[- ]?(\\d+)", "type": "air_handling_unit", "unit": "No"},
      "FD": {"regex": "FD([1-5]|A)", "type": "fire_damper", "unit": "No", "variants": ["FD1","FD2","FD3","FD4","FD5","FDA"]},
      "FHC": {"regex": "FHC", "type": "fire_hatch_cover", "unit": "No"},
      "SPD": {"regex": "SPD", "type": "smoke_pressure_damper", "unit": "No"},
      "GL": {"regex": "GL[23]", "type": "grille_louver", "unit": "No", "variants": ["GL2","GL3"]},
      "SA": {"regex": "SA[- ]?\\d+", "type": "supply_air_diffuser", "unit": "No"},
      "RA": {"regex": "RA[- ]?\\d+", "type": "return_air_grille", "unit": "No"},
      "EA": {"regex": "EA[- ]?\\d+", "type": "exhaust_air_grille", "unit": "No"},
      "VAV": {"regex": "VAV[- ]?\\d+", "type": "vav_box", "unit": "No"},
      "FCU": {"regex": "FCU[- ]?\\d+", "type": "fan_coil_unit", "unit": "No"},
      "EF": {"regex": "EF[- ]?\\d+", "type": "exhaust_fan", "unit": "No"},
      "SF": {"regex": "SF[- ]?\\d+", "type": "supply_fan", "unit": "No"}
    },
    "dimension_patterns": {
      "room_size": "(\\d{3,5})\\s*[xX]\\s*(\\d{3,5})",
      "duct_size": "(\\d{2,4})\\s*[xX]\\s*(\\d{2,4})\\s*(?:mm)?"
    },
    "measurements": {
      "duct_unit": "SQMT",
      "pipe_unit": "RMT",
      "pipe_multiplier": 2,
      "duct_area_method": "length × perimeter"
    },
    "room_keywords": ["AHU ROOM", "BOYS TOILET", "GIRLS TOILET", "STORE ROOM", "HUB ROOM", "DB ROOM", "LOBBY", "ELECTRICAL", "BATTERY", "SHAFT"]
  },

